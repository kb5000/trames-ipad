  "changes": [
    "Actual CLONE_VM tasks acquire one native mm reference; captured/cloned capabilities retain the same task. Source and owner exit use the same idempotent retirement.",
    "Fork isolates native spaces; successful exec replaces its task reference without discarding other real shared-mm users; failed exec preserves it.",
    "Final native roots are taken under mm membership synchronization and dropped after unlocking. Accepted native leases keep their original resources. Weak caches avoid mm membership locks on initialized lookups.",
    "Kernel native lifetime maps, ProcessMap native-liveness scans and owner drive-loop abandoned GPU polling are removed. Group exit/exec abandon removed threads original GPU jobs.",
    "Existing native completion/availability notifications retain and retire pending GPU graphs. Busy callbacks return rather than block. Actual notifications are coalesced/rearmed; reaper unlock wakes normal callers while excluding its own listener.",
    "An unlock also handles completion already consumed by another native caller, avoiding a retained cycle without depending on another completion event."
  ],
  "concurrency": {
    "new_resource_or_service_thread": false,
    "new_polling_bus": false,
    "new_production_unsafe": false,
    "new_ordinary_guest_memory_barrier": false,
    "new_native_permission_model": false,
    "ordinary_native_locking": "Source calls keep captured original context/stream leases; initialized cache hits bypass mm membership mutex. Existing private Vulkan graph mutex is retained.",
    "notification_sync": "Release/acquire only for actual callback notification state; task reference scalars use relaxed atomics. Contention returns until actual unlock, not a busy retry.",
    "lifetime_safety": "Existing OwnedBackend isolated Rc envelope remains under its original mutex. Callbacks retain no guest View or page borrow. Temporary native graph keepalive is broken after both resource locks release."
  },
  "mechanism_regressions": [
    {
      "case": "Final mm release while two real native task workers remain gated",
      "green": "backend::completion::retirement_tests::final_mm_release_returns_before_two_native_jobs_and_each_completion_releases_its_graph",
