      "green": "process::tests::unrelated_headless_execution_does_not_wait_for_a_busy_native_address_space",
      "red": "Reintroducing the old owner polling mechanism on current original contexts prevents the headless program from finishing before lease release; this is an injected old mechanism, not an unmodified published binary.",
      "red_log_sha256": "60446a123c9b377b4ddbf9f2c31df0530a459a2e5d5abe77dccb83ed038b89f0"
    },
    {
      "case": "Busy context callbacks and repeated completion/unlock races",
      "green": "30 guarded races; callback returns while leased, then original unlock/completion retires graph without owner polling"
    },
    {
      "case": "Another native caller consumed completion before unlock",
      "green": "Task completion observed through original task readiness without aggregate delivery; subsequent native unlock releases the graph"
    },
    {
      "case": "Real source exit and stale capability",
      "green": "Existing worker exit matrix now checks original native root retirement before owner projection collection, including excluded controls and legacy wait behavior"
    },
    {
      "case": "Mm members, accepted leases and original cache",
      "green": "Concurrent original owners release once; late capabilities cannot recreate resources; destructor reentry occurs unlocked; normal cache hit completes while membership mutex is held"
    }
