  "mechanism_regressions": [
    {
      "case": "Nine full-queue termination modes with an unrelated CPU still busy",
      "assertions": "Parent consumes child status within the same epoch; no 93/94 cohort return. Includes ordinary/final/group exits, running/sleeping/cold/traced peers, default TERM, default synchronous SEGV and surviving CLONE_VM clear_tid visibility."
    },
    {
      "case": "External physical mm borrow held across wait/reap/PID reuse",
      "assertions": "Guest family completion does not wait for external borrow. Original mm remains retained, accepts late guarded writes, and drops through original readiness without touching the new task."
    },
    {
      "case": "Late dirty bit while legacy provider publishes a different frame",
      "assertions": "Retired publication preserves the dirty-word journal until the last borrowed generation returns.",
      "negative_control": "Disabling journal retention reproduces backing byte 0 instead of 9; isolated source restored automatically.",
      "log_sha256": "af640fd3da46f01ef717643dfb064f0cacd8a89fca87a1eb08e0f6f539a7ed6c"
    }
