  "scope": {
    "migrated": [
      "Paired Unix stream/datagram/seqpacket sendmsg/recvmsg use one original ancillary ABI on workers.",
      "Portable rights own actual shared OFDs in their packet, without an owner rights ledger.",
      "Actual Files admission/publication retains original identity, flags, close behavior and existing bounds.",
      "Accepted waits import headers, buffers, credentials and rights once; source FD reuse and changed guest headers cannot retarget them.",
      "Existing resource subscriptions return the execution slot. Filtered calls keep one decision across parking/cohorts and the next SVC uses the current filter.",
      "The joined owner retains the original local control OFD before returned owner mutations execute; fallback uses the accepted message and original transport.",
      "Stopped tasks are excluded from I/O adoption even when they retain a message or another wait."
    ],
    "still_owner": [
      "Unix socket creation/control and addressed datagrams",
      "Rights containing owner-only resource kinds and original ownership-cycle policy",
      "Native Unix service pumping and task/signal authority",
      "Structural VM/device ownership; the overall coordinator-removal goal remains active"
    ],
    "constraints": [
      "No new unsafe, thread, bus, global network lock, resource quota or ordinary guest-memory barrier.",
      "Ready messages avoid retained-message allocations; empty rights avoid Files locking; receive options use the existing channel lock.",
      "Final-close callbacks and truncated/closed queued rights are released outside channel and Files locks."
    ]
  },
